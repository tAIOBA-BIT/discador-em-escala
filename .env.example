# Modo padrão seguro para desenvolvimento
TELEPHONY_PROVIDER=simulator
PUBLIC_BASE_URL=http://localhost:3000

# Ative apenas após configurar a conta e os webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SELLER_DESTINATION=sip:vendedor@example.sip.twilio.com
PROVIDER_CONCURRENCY_LIMIT=10

# Salvaguardas
CALLING_START_HOUR=9
CALLING_END_HOUR=18
MAX_ATTEMPTS_PER_30_DAYS=3
MIN_RETRY_INTERVAL_MINUTES=60
RETENTION_DAYS=90
NOTES_RETENTION_DAYS=30

# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
RETENTION_JOB_TOKEN=
